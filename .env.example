# Bandhoo - Environment Configuration Template
# Copy this file to .env and configure values appropriate for your environment.
# NEVER commit .env files containing real passwords or secrets to version control.

# ==============================================================================
# 1. Database Configuration (PostgreSQL / SQLite)
# ==============================================================================
# Production / Staging PostgreSQL connection URI:
# DATABASE_URL=postgresql://bandhoo_user:secure_password@localhost:5432/bandhoo_db
# Local development default:
DATABASE_URL=sqlite:///bandhoo_persistence.db

# Database Connection Pool Settings (PostgreSQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ==============================================================================
# 2. Private Controlled File Storage
# ==============================================================================
# Files (uploaded evidence, generated PDFs) are stored in this private directory
# outside web-accessible roots. Storage keys are saved in PostgreSQL.
BANDHOO_STORAGE_DIR=./private_storage

# ==============================================================================
# 3. Security, CORS and Network Restrictions
# ==============================================================================
# Comma-separated list of allowed frontend origins (CORS)
BANDHOO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Skip reading local .env file (useful during CI/automated unit testing)
BANDHOO_SKIP_DOTENV=0

# ==============================================================================
# 4. Legal Reasoning & Optional Gemini Fallback
# ==============================================================================
# Google Gemini API key (optional; system operates offline via BM25 statutory retrieval if omitted)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# ==============================================================================
# 5. Application Server
# ==============================================================================
BANDHOO_HOST=0.0.0.0
BANDHOO_PORT=8001
